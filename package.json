{
  "name": "scroma",
  "version": "0.1.0",
  "description": "Scroma - Screenshot Mockup Tool",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
